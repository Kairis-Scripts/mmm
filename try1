	end
end

local function deepCopyTable(original, seen)
	local seenMap = seen or {}
	if type(original) ~= "table" then return original end
	if seenMap[original] then return seenMap[original] end
	local copy = {}
	seenMap[original] = copy
	for k, v in next, original, nil do
		copy[deepCopyTable(k, seenMap)] = deepCopyTable(v, seenMap)
	end
	setmetatable(copy, deepCopyTable(getmetatable(original), seenMap))
	return copy
end

