local function roundToThreeDecimals(num)
	return num >= 0
		and math.floor(num * 1000 + 0.5) / 1000
		or math.ceil(num * 1000 - 0.5) / 1000
end

local function getItemValue(itemName, itemType, rarity, isChroma)
	local lookupCategory
	if itemType == "Pet" then
		lookupCategory = "Pet"
	else
		lookupCategory = rarityTypeRemap[rarity] or rarity
	end

	local categoryTable = valueLib[lookupCategory]
	if not categoryTable then return 0 end

	local keyA, keyB, keyC
	if isChroma then
		categoryTable = valueLib.Chroma
		if not categoryTable then return 0 end
		local chromaKey = string.lower("chroma " .. itemName)
		keyA = chromaKey
		keyB = string.lower(chromaKey .. " (" .. string.lower(itemType) .. ")")
		keyC = string.lower(chromaKey .. " " .. itemType)
	else
		keyA = string.lower(itemName)
		keyB = keyA .. " (" .. string.lower(itemType) .. ")"
		keyC = keyA .. " " .. itemType
	end

	return categoryTable[keyA] or categoryTable[keyB] or categoryTable[keyC] or 0
end

